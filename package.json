{
  "name": "miku-pptx2md",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-miku-pptx2md.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "pretest:unit": "npm run build",
    "test:unit": "node --test tests/*.test.mjs",
    "cli": "node scripts/miku-pptx2md-cli.mjs",
    "presmoke:version": "npm run build",
    "smoke:version": "node scripts/miku-pptx2md-cli.mjs --version",
    "prebuild:runtime": "npm run build",
    "build:runtime": "node scripts/build-runtime-bundle.mjs",
    "prebuild:bundle": "npm run build",
    "build:bundle": "node scripts/build-runtime-bundle.mjs",
    "presmoke:bundle": "npm run build:bundle",
    "smoke:bundle": "node scripts/smoke-cli-bundle.mjs",
    "smoke:runtime": "node scripts/smoke-runtime-bundle.mjs",
    "test:browser": "npm run build:runtime && playwright test"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.7.3",
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22"
  }
}
